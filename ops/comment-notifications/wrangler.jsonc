{
  "$schema": "../../blog/node_modules/wrangler/config-schema.json",
  "name": "scary-spider-seo-comment-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALERT_FROM_EMAIL": "alerts@blog.scaryspiderseo.com"
  },
  "kv_namespaces": [
    {
      "binding": "COMMENT_NOTIFICATION_STATE",
      "id": "3e3d1c081e6a4198b69dc53f126a7057"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "comment-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "comment-notifications-dlq"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "scary-spider-seo-comment-notifications-staging",
      "vars": {
        "ALERT_FROM_EMAIL": "alerts@blog.scaryspiderseo.com"
      },
      "kv_namespaces": [
        {
          "binding": "COMMENT_NOTIFICATION_STATE",
          "id": "e17081bafd81497888a2a1ae13042b33"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "comment-notifications-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "comment-notifications-dlq-staging"
          }
        ]
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "persist": true
        }
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  }
}
