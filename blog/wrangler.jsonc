{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scary-spider-seo-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE9y8n5uCUoWWVvK",
    "TURNSTILE_HOSTNAME": "blog.scaryspiderseo.com"
  },
  // TURNSTILE_SITE_KEY is public configuration and is declared in vars.
  // SESSION_SECRET and TURNSTILE_SECRET_KEY are secrets, so set them with
  // `wrangler secret put` for production and in the gitignored `.dev.vars`
  // files for local development. User passwords live hashed in the `users`
  // D1 table, not in an environment variable.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domain: point blog.scaryspiderseo.com at this Worker in the
  // Cloudflare dashboard (Workers & Pages > Domains & Routes), then it
  // shows up here automatically, or add it manually as:
  // "routes": [{ "pattern": "blog.scaryspiderseo.com", "custom_domain": true }]
  "routes": [],
  // Run `wrangler d1 create blog-db` once, then paste the returned
  // database_id below (and mirror it in .dev.vars / wrangler for local dev).
  // ISR cache for OpenNext: pages use `export const revalidate` and server
  // actions call `revalidatePath()`, which only work with a real incremental
  // cache (open-next.config.ts wires the KV-backed cache + memory queue).
  // One namespace, two binding names (NEXT_INC_CACHE_KV + NEXT_TAG_CACHE_KV).
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "67b80fb5c4634f4fb6323bcdb17bbfd4" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "67b80fb5c4634f4fb6323bcdb17bbfd4" },
    { "binding": "RATE_LIMITS", "id": "66c2ed03b5724ac98f44190116204951" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "dfc47a69-fd5c-4781-bd41-dab6fe1df1e9",
      "migrations_dir": "migrations"
    }
  ],
  // Run `wrangler r2 bucket create blog-media` once, then this binding
  // is ready to use for post images/attachments.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "blog-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "COMMENT_NOTIFICATIONS",
        "queue": "comment-notifications"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "scary-spider-seo-blog-staging",
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE9zc2Pmiy09kWBM",
        "TURNSTILE_HOSTNAME": "scary-spider-seo-blog-staging.lthung-work-79.workers.dev"
      },
      "kv_namespaces": [
        { "binding": "NEXT_INC_CACHE_KV", "id": "d57b4db4e2e744b5b97078bac5e2b4a4" },
        { "binding": "NEXT_TAG_CACHE_KV", "id": "d57b4db4e2e744b5b97078bac5e2b4a4" },
        { "binding": "RATE_LIMITS", "id": "e7077526ff91482ab31ef1a3fd785b46" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-db-staging",
          "database_id": "9bd7d961-0496-49cd-a66f-f2d089413990",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "blog-media-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "COMMENT_NOTIFICATIONS",
            "queue": "comment-notifications-staging"
          }
        ]
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
