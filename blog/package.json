{
  "name": "scary-spider-seo-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cf-build.mjs && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-db --remote",
    "db:studio": "drizzle-kit studio",
    "admin:hash-password": "node scripts/hash-password.mjs",
    "db:seed": "node scripts/seed.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "drizzle-orm": "^0.44.5",
    "marked": "^18.0.13",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "wrangler": "^4.31.0"
  }
}
